    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst ahora = Date.now();\n\nconst paraActualizar = [];\n\nfor (const item of items) {\n  const row = item.json;\n  \n  // Usamos createdAt o una columna fija de fecha de último mensaje enviado por el usuario\n  // NUNCA la fecha en que el Cron actualiza la tabla.\n  const fechaFijaMensaje = row.createdAt; \n\n  if (fechaFijaMensaje) {\n    const tiempoOrigen = new Date(fechaFijaMensaje).getTime();\n    \n    // Calculamos las horas acumuladas desde que el usuario escribió ese mensaje\n    const diferenciaHoras = (ahora - tiempoOrigen) / (1000 * 60 * 60);\n\n    paraActualizar.push({\n      json: {\n        id: row.id,\n        celular: row.celular,\n        // Devuelve el acumulado real que irá creciendo: 0.15 -> 0.40 -> 1.25 -> 3.00\n        tiempo_transcurrido: Number(diferenciaHoras.toFixed(2))\n      }\n    });\n  }\n}\n\nreturn paraActualizar;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
