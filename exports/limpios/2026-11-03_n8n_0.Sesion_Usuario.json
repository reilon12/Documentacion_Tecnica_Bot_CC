      "id": "564593ee-4ea3-4f86-b11c-38dca56dab04",
      "name": "Sticky Note2"
    },
    {
      "parameters": {
        "jsCode": "// Captura el objeto de error provisto por el Error Trigger\nconst errorInput = $input.first()?.json || {};\n\n// Extrae la información relevante del fallo\nconst nodoFallido = errorInput.execution?.lastNodeExecuted || \"Nodo Desconocido\";\nconst mensajeError = errorInput.error?.message || \"Error no especificado\";\nconst workflowOrigen = errorInput.workflow?.name || \"Workflow Desconocido\";\n\n// Prepara la respuesta que n8n entiende y retorna\nreturn [\n  {\n    json: {\n      exito: false,\n      nodo_con_error: nodoFallido,\n      mensaje_tecnico: mensajeError,\n      workflow: workflowOrigen,\n      mensaje_usuario: \"⚠️ En este momento estamos experimentando problemas de conexión. Por favor, intenta de nuevo en unos minutos.\",\n      timestamp: new Date().toISOString()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1552,
        416
      ],
      "id": "a0d63f7f-39ea-4be4-a8ab-8b0f008da8d5",
      "name": "informacion_falla_nodo"
    },
    {
      "parameters": {
        "fromEmail": "<EMAIL>",
        "toEmail": "<EMAIL_DESTINO>",
        "subject": "=Alerta de Error en {{ $json.workflow }}",
        "html": "=Se ha detectado un error en el sistema.\n\n• Workflow: {{ $json.workflow }}\n\n• Nodo con error: {{ $json.nodo_con_error }}\n\n• Detalle técnico: {{ $json.mensaje_tecnico }}\n\n• Fecha/Hora: {{ $json.timestamp }}",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
