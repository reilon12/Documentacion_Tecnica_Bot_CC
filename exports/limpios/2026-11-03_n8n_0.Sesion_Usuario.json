    {
      "parameters": {
        "jsCode": "// Obtener la fila devuelta por la Data Table\nconst item = $input.first()?.json;\n\n// Si no devolvió registro o no tiene session_id, la sesión no es válida\nif (!item || !item.session_id) {\n  return [{\n    json: {\n      existe_sesion: false,\n      sesion_valida: false\n    }\n  }];\n}\n\n// Obtener la fecha de la última interacción\nconst ultimaActualizacion = new Date(item.updatedAt).getTime();\nconst ahora = new Date().getTime();\n\n// Diferencia en horas\nconst horasDiferencia = (ahora - ultimaActualizacion) / (1000 * 60 * 60);\n\n// Es válida si han pasado menos de 3 horas\nconst esValida = horasDiferencia < 3;\n\nreturn [{\n  json: {\n    ...item,\n    sesion_valida: esValida,\n    horas_transcurridas: horasDiferencia.toFixed(2)\n  }\n}];"
      },
